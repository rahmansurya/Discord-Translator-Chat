{
  "manifest_version": 3,
  "name": "Penterjemah Chat Discord",
  "version": "2.0",
  "description": "Terjemahkan chat Discord otomatis ke bahasa Indonesia",
  "permissions": ["storage"],
  "host_permissions": ["https://discord.com/*"],
  "content_scripts": [
    {
      "matches": ["https://discord.com/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pengaturan Penterjemah"
  },
  "icons": {
    "128": "icon128.png"
  }
}
